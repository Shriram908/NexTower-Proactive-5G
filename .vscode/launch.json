{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NexTower: simulate all policies",
      "type": "debugpy",
      "request": "launch",
      "module": "nextower",
      "args": ["simulate", "--config", "configs/blocked_corridor.yaml", "--policy", "all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NexTower: validate scenario",
      "type": "debugpy",
      "request": "launch",
      "module": "nextower",
      "args": ["validate", "--config", "configs/blocked_corridor.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
